# Teleforge (dsh-telegram) docker stack — environment template.
# Copy to `docker/.env` (or export these in the shell) before `docker compose up`.
# docker compose reads docker/.env automatically (compose looks in the project dir).

# REQUIRED: Telegram bot token. Must be valid-format `^\d+:[A-Za-z0-9_-]+$`,
# else the plugin idles and never registers the webhook.
# For load/webhook-register verification a placeholder like `123456:ABC_DEF-1`
# is enough; for real end-to-end use a real token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Webhook path (default /telegram/webhook).
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Optional shared secret; if set, Telegram must send it back as
# `X-Telegram-Bot-Api-Secret-Token`. Protects the webhook from forgery.
TELEGRAM_WEBHOOK_SECRET=

# Public base URL (https://...) for phase-2 real end-to-end (setWebhook target).
# Leave empty for phase-1 load/register verification.
TELEGRAM_PUBLIC_URL=

# Optional access whitelist: comma-separated Telegram user ids / chat ids.
# Empty = allow all.
TELEGRAM_ALLOW_USERS=
TELEGRAM_ALLOW_CHATS=

# Reply parse mode: 'None' | 'Markdown' | 'HTML'.
TELEGRAM_PARSE_MODE=None

# Optional LLM route for the web profile (provider/model your DSH deployment uses).
# DSH_LLM_PROVIDER=
# DSH_LLM_MODEL=
